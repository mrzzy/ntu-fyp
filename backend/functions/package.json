    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@openrouter/sdk": "^1.2.83",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.1.11",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^6.0.0",
    "uuid": "^14.0.2",
    "vitest": "^4.1.11"
  },
  "private": true
}
